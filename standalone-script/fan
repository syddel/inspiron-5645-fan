#!/usr/bin/env bash

HWMON_NAME="dell_smm"

# ---------------------------------------------------------------------------
# Locate the hwmon directory by device name (hwmonN index is not stable).
# ---------------------------------------------------------------------------
find_hwmon() {
    local d
    for d in /sys/class/hwmon/hwmon*; do
        [[ -d "$d" ]] || continue
        if [[ "$(cat "$d/name" 2>/dev/null)" == "$HWMON_NAME" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

HWMON_DIR=$(find_hwmon) || {
    echo "ERROR: hwmon device '$HWMON_NAME' not found." >&2
    echo "Available hwmon devices:" >&2
    for d in /sys/class/hwmon/hwmon*; do
        [[ -d "$d" ]] || continue
        printf '  %s -> %s\n' "$d" "$(cat "$d/name" 2>/dev/null)" >&2
    done
    exit 1
}

PWM="$HWMON_DIR/pwm1"
ENABLE="$HWMON_DIR/pwm1_enable"
RPM="$HWMON_DIR/fan1_input"
CPU_TEMP="$HWMON_DIR/temp1_input"

case "$1" in
    auto)
        echo 2 | sudo tee "$ENABLE" >/dev/null
        echo "Fan control: automatic"
        ;;

    status)
        ENABLE_STATE=$(cat "$ENABLE")

        if [[ "$ENABLE_STATE" == "1" ]]; then
            STATUS="manual"
            CURRENT_PWM=$(cat "$PWM")
        else
            STATUS="automatic"
            CURRENT_PWM="N/A"
        fi

        CURRENT_RPM=$(cat "$RPM")
        CPU_TEMP_VALUE=$(cat "$CPU_TEMP")
        CPU_TEMP_C=$((CPU_TEMP_VALUE / 1000))

        echo "Status: $STATUS"
        echo "PWM: $CURRENT_PWM"
        echo "Current RPM: $CURRENT_RPM"
        echo "CPU Temperature: ${CPU_TEMP_C}°C"
        ;;

    ''|*[!0-9]*)
        echo "Usage: fan {0-255|auto|status}"
        exit 1
        ;;

    *)
        if (( "$1" > 255 )); then
            echo "PWM must be between 0 and 255"
            exit 1
        fi

        echo 1 | sudo tee "$ENABLE" >/dev/null
        echo "$1" | sudo tee "$PWM" >/dev/null
        echo "Fan PWM: $1"
        ;;
esac
